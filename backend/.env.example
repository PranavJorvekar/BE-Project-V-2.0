# AI SDLC Backend Environment Variables
# Copy to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aisdlc?schema=public"

# OpenAI (primary LLM provider)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AI Generation Mode: "real" uses LLM, "mock" returns structured dummy data
AI_MODE=mock
