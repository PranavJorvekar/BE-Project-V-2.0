// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      String    @default("member") // admin | manager | member | viewer
  clerkId   String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  name            String
  description     String
  features        String // JSON array
  techStack       String // JSON array
  priorities      String // JSON array
  timeline        Int          @default(8) // weeks
  status          String       @default("DRAFT") // DRAFT | GENERATING | IN_PLANNING | IN_PROGRESS | COMPLETED
  progress        Int          @default(0) // 0-100
  generationJobId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  epics           Epic[]
  teamMembers     TeamMember[]
  warnings        Warning[]
}

model Epic {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code            String // e.g. "EPIC-01"
  name            String
  goal            String
  priority        String   @default("Medium") // High | Medium | Low
  taskCount       Int      @default(0)
  totalHours      Int      @default(0)
  scopeHighlights String // JSON array of strings
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tasks           Task[]
}

model Task {
  id               String      @id @default(uuid())
  epicId           String
  epic             Epic        @relation(fields: [epicId], references: [id], onDelete: Cascade)
  teamMemberId     String?
  teamMember       TeamMember? @relation(fields: [teamMemberId], references: [id])
  name             String
  description      String
  skills           String // JSON array
  effort           Int // hours
  priority         String      @default("Medium")
  fitScore         Int         @default(0) // 0-100
  aiReasoning      String      @default("")
  definitionOfDone String      @default("[]") // JSON array
  prerequisites    String      @default("[]") // JSON array of task IDs
  blocks           String      @default("[]") // JSON array of task IDs
  alternatives     String      @default("[]") // JSON array of {name, role, score}
  orderIndex       Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model TeamMember {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id])
  name           String
  role           String
  initials       String
  specialization String    @default("")
  skills         String // JSON array
  experience     String    @default("mid") // junior | mid | senior | lead
  weeklyHours    Int       @default(40)
  weeklyCapacity String    @default("[60,70,75,80,85,70,65,60]") // JSON array of % per week
  avgCapacity    Int       @default(70) // percentage
  availableHours Int       @default(15)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tasks          Task[]
}

model Warning {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  severity        String // Critical | High | Medium
  title           String
  affectedArea    String
  icon            String   @default("warning")
  problem         String
  recommendations String // JSON array
  actionLabel     String   @default("View Plan")
  dismissed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Employee {
  id                 String       @id @default(uuid())
  name               String
  role               String
  initials           String
  specialization     String       @default("")
  skills             String // JSON array
  experience         String       @default("mid") // junior | mid | senior | lead
  weeklyHours        Int          @default(40)
  availabilityStatus String       @default("available") // available | busy | on_leave
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  teamMembers        TeamMember[]
}
